  "comments": [
    {
      "id": 1,
      "x": 1200,
      "y": 1705.5,
      "width": 646,
      "height": 259,
      "title": "Sprite UV",
      "description": "Normalised position inside the sprite, 0..1 on both axes",
      "color": "#5b7fa6"
    },
    {
      "id": 2,
      "x": 0,
      "y": 1943,
      "width": 900,
      "height": 289,
      "title": "Height",
      "description": "0 at the bottom of the sprite, 1 at the top",
      "color": "#5b7fa6"
    },
    {
      "id": 3,
      "x": 1200,
      "y": 1011.5,
      "width": 1069,
      "height": 571.5,
      "title": "Rising noise",
      "description": "FBM scrolled upward over time — the flame licks",
      "color": "#8a6fb0"
    },
    {
      "id": 4,
      "x": 0,
      "y": -1937,
      "width": 690,
      "height": 309,
      "title": "Erosion threshold",
      "description": "Higher up the sprite, more noise is needed to keep a pixel",
      "color": "#b0715a"
    },
    {
      "id": 5,
      "x": -132,
      "y": -854,
      "width": 2000,
      "height": 754,
      "title": "Stretched sprite",
      "description": "Sample the sprite's own texture shifted upward by the noise, more so near the top",
      "color": "#b0715a"
    },
    {
      "id": 6,
      "x": 1892,
      "y": -782.5,
      "width": 240,
      "height": 275,
      "title": "Stretched sprite alpha",
      "description": "The stretched sprite's alpha is the raw flame shape",
      "color": "#b0715a"
    },
    {
      "id": 7,
      "x": 0,
      "y": 1004,
      "width": 1130,
      "height": 824,
      "title": "Flame mask",
      "description": "Stretched alpha eroded into separate flame tips",
      "color": "#b0715a"
    },
    {
      "id": 8,
      "x": 0,
      "y": -1513,
      "width": 1330,
      "height": 544,
      "title": "Heat",
      "description": "Hot at the bottom, cooling toward the tips, modulated by the noise",
      "color": "#c0873a"
    },
    {
      "id": 9,
      "x": 0,
      "y": 0,
      "width": 2180,
      "height": 889,
      "title": "Fire color",
      "description": "Cool → mid → hot gradient by heat, blended with the sprite's own colors, premultiplied by the flame mask",
      "color": "#c0873a"
    }
  ],
  "nodeIdCounter": 72,
  "commentIdCounter": 10,
  "uniforms": [
    {
      "id": 1,
      "paramId": "bmlt7x7w",
      "name": "speed",
      "variableName": "uniform_speed",
      "description": "How fast the flames rise",
      "type": "float",
      "value": 1,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 2,
      "paramId": "zhpc5lwi",
      "name": "noiseScale",
      "variableName": "uniform_noiseScale",
      "description": "Size of the flame licks (higher = smaller licks)",
      "type": "float",
      "value": 4,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 3,
      "paramId": "jkst75vb",
      "name": "distortion",
      "variableName": "uniform_distortion",
      "description": "How far the sprite's shape is stretched upward by the flames, as a fraction of its height",
      "type": "float",
      "value": 0.25,
      "isPercent": true,
      "isDeprecated": false
    },
    {
      "id": 4,
      "paramId": "cky03z3o",
      "name": "erosion",
      "variableName": "uniform_erosion",
      "description": "How much of the top of the sprite burns away into separate flames",
      "type": "float",
      "value": 0.6,
      "isPercent": true,
      "isDeprecated": false
    },
    {
      "id": 5,
      "paramId": "w04e857b",
      "name": "flameHeight",
      "variableName": "uniform_flameHeight",
      "description": "Height of the hottest region, from the bottom of the sprite",
      "type": "float",
      "value": 0.5,
      "isPercent": true,
      "isDeprecated": false
    },
    {
      "id": 6,
      "paramId": "atk464g2",
