{
  "version": "1.0.0",
  "formatVersion": 1,
  "shaderSettings": {
    "name": "CRT",
    "version": "1.4.0.0",
    "author": "",
    "website": "",
    "documentation": "",
    "description": "Turns whatever is under the sprite into a CRT picture: barrel distortion, scanlines, phosphor mask, glow and signal glitches. The sprite is a mask: alpha is where the effect draws, red scales the phosphor mask, green the colour fringing, blue the scanlines.",
    "category": "distortion",
    "blendsBackground": true,
    "crossSampling": false,
    "preservesOpaqueness": true,
    "animated": true,
    "isDeprecated": false,
    "usesDepth": false,
    "mustPredraw": false,
    "supports3DDirectRendering": false,
    "extendBoxH": 0,
    "extendBoxV": 0,
    "floatPrecision": "highp",
    "targetWebgl1": true,
    "targetWebgl2": true,
    "targetWebgpu": true
  },
