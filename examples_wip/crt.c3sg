            {
              "id": "crt_glow_sum",
              "name": "sum",
              "type": "vec3"
            }
          ]
        },
        "notes": "Adds up 8 reads around uv: 4 at 1.5 line-grid pixels (a cross), 4 at 2.5 diagonally. The caller runs it 0 times when Glow is 0.",
        "maxWebgl1Iterations": 8
      },
