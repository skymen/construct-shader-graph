  "comments": [
    {
      "id": 1,
      "x": 2020,
      "y": 5274,
      "width": 1066,
      "height": 836.5,
      "title": "Mask sprite",
      "description": "The sprite's own pixels, straight alpha. A is where the CRT draws; R, G and B scale the phosphor mask, the colour fringing and the scanlines.",
      "color": "#4a90e2"
    },
    {
      "id": 2,
      "x": 2560,
      "y": -4593,
      "width": 1090,
      "height": 1369,
      "title": "Object space",
      "description": "Where this pixel sits on the sprite (rotation-safe), how many lines Line Height gives, one line-grid pixel in UV units, and the frame counter the noise steps with.",
      "color": "#4a90e2"
    },
    {
      "id": 3,
      "x": 1770,
      "y": -4585.5,
      "width": 720,
      "height": 597.5,
      "title": "Barrel distortion",
      "description": "Curves the picture like bulging glass and zooms in by Fill to hide the black edges. tube_uv is where each pixel lands on the tube.",
      "color": "#4a90e2"
    },
    {
      "id": 4,
      "x": 1460,
      "y": -5230.5,
      "width": 1719,
      "height": 401.5,
      "title": "Glitch bursts",
      "description": "One gate for every glitch: always open, or only in short random bursts.",
      "color": "#4a90e2"
    },
    {
      "id": 5,
      "x": 0,
      "y": -5238,
      "width": 1390,
      "height": 2014,
      "title": "Vertical roll",
      "description": "Lost vertical hold: the picture scrolls down, with a dark blanking bar where it wraps.",
      "color": "#4a90e2"
    },
    {
      "id": 6,
      "x": 3490,
      "y": 22.5,
      "width": 3020,
      "height": 4021.5,
      "title": "Jitter, wobble, tearing",
      "description": "Sideways shifts of the signal: per line every frame, a slow bend, and bands shoved aside.",
      "color": "#4a90e2"
    },
    {
      "id": 7,
      "x": 0,
      "y": -3109,
      "width": 2490,
      "height": 3009,
      "title": "Power",
      "description": "Switch-off: the raster squashes to a bright line, then shrinks to a dot.",
      "color": "#4a90e2"
    },
    {
      "id": 8,
      "x": 0,
      "y": 5274,
      "width": 1950,
      "height": 2879,
      "title": "Read the picture",
      "description": "Three background reads with red and blue pulled apart toward the edges, then the ghost echo and the glow. Both are loops whose count drops to 0, skipping their reads, when their amount is 0.",
      "color": "#4a90e2"
    },
    {
      "id": 9,
      "x": 0,
      "y": 15,
      "width": 3420,
      "height": 5144,
      "title": "Signal damage",
      "description": "Dropout streaks, RF interference, grain and snow, added before the beam draws the picture.",
      "color": "#4a90e2"
    },
    {
      "id": 10,
      "x": 3490,
      "y": 4159,
      "width": 1760,
      "height": 2989,
      "title": "Beam and phosphors",
      "description": "Scanlines on the tube's raster, then the phosphor mask Mask Type picks.",
      "color": "#4a90e2"
    },
    {
      "id": 11,
      "x": 2560,
      "y": -3109,
      "width": 2450,
      "height": 2874,
      "title": "Tone",
      "description": "Vignette, brightness, flicker, hum bar, the switch-off glow and the roll's blanking bar.",
      "color": "#4a90e2"
    },
    {
      "id": 12,
      "x": 0,
      "y": -5822,
      "width": 1310,
      "height": 469,
      "title": "Output",
      "description": "Black past the screen's edge, then premultiplied by the mask's coverage.",
      "color": "#4a90e2"
    }
  ],
  "nodeIdCounter": 522,
  "commentIdCounter": 13,
  "uniforms": [
    {
      "id": 1,
      "paramId": "curvature",
      "name": "Curvature",
      "variableName": "uniform_Curvature",
      "description": "How strongly the glass bulges. 0 is flat.",
      "type": "float",
      "value": 0.2,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 28,
      "paramId": "flatness",
      "name": "Flatness",
      "variableName": "uniform_Flatness",
      "description": "0% bends evenly out from the centre. Higher keeps the middle flat and gathers the curve at the edges.",
      "type": "float",
      "value": 0.5,
      "isPercent": true,
      "isDeprecated": false
    },
    {
      "id": 2,
      "paramId": "fill",
      "name": "Fill",
      "variableName": "uniform_Fill",
      "description": "Zoom that hides the black edges the curve opens up. 100% is the smallest zoom that leaves none.",
      "type": "float",
      "value": 1,
      "isPercent": true,
      "isDeprecated": false
    },
    {
      "id": 3,
