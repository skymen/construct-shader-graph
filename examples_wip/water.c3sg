  "comments": [
    {
      "id": 1,
      "x": -826,
      "y": -1651,
      "width": 866,
      "height": 256,
      "title": "Wave space",
      "description": "UV normalised to 0..1 across the object, then scaled so Wave Scale is the number of wave cells across it.",
      "color": "#4a90e2"
    },
    {
      "id": 2,
      "x": -680,
      "y": 1789,
      "width": 720,
      "height": 456,
      "title": "Wave field",
      "description": "Height of the water at this pixel. Sampled again just to the right and just below, so the three taps can be differenced into a slope.",
      "color": "#4a90e2"
    },
    {
      "id": 3,
      "x": -1850,
      "y": -1306,
      "width": 1890,
      "height": 1106,
      "title": "Surface normal",
      "description": "The two finite differences become the X and Y of a surface normal; the epsilon becomes its Z, which keeps the tilt independent of the sampling step.",
      "color": "#4a90e2"
    },
    {
      "id": 4,
      "x": -606,
      "y": -1976,
      "width": 646,
      "height": 271,
      "title": "Shape mask",
      "description": "The object's own alpha, so the water stays inside its silhouette.",
      "color": "#4a90e2"
    },
    {
      "id": 5,
      "x": -1110,
      "y": 1334,
      "width": 1150,
      "height": 336,
      "title": "Crest foam",
      "description": "White foam on the top of the waves, faded in over the highest part of the height range.",
      "color": "#4a90e2"
    },
    {
      "id": 6,
      "x": 631,
      "y": 1334,
      "width": 639,
      "height": 261,
      "title": "Clock",
      "description": "Seconds since start, scaled by the Speed parameter. Drives the whole wave field.",
      "color": "#4a90e2"
    },
    {
      "id": 7,
      "x": -2640,
      "y": -281,
      "width": 2650,
      "height": 1526,
      "title": "Composite",
      "description": "Tint the refracted background, add the glint and the foam, then fade the whole thing in behind the object's alpha.",
      "color": "#4a90e2"
    }
  ],
  "nodeIdCounter": 70,
  "commentIdCounter": 8,
  "uniforms": [
    {
      "id": 1,
      "paramId": "svelii5r",
      "name": "speed",
      "variableName": "uniform_speed",
      "description": "How fast the wave field evolves.",
      "type": "float",
      "value": 0.35,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 2,
      "paramId": "khz99h3r",
      "name": "waveScale",
      "variableName": "uniform_waveScale",
      "description": "Number of wave cells across the object.",
      "type": "float",
      "value": 4,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 3,
      "paramId": "v07zfguw",
      "name": "waveHeight",
      "variableName": "uniform_waveHeight",
      "description": "Steepness of the wave normals.",
      "type": "float",
      "value": 1,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 4,
      "paramId": "gt6i3ogr",
      "name": "refraction",
      "variableName": "uniform_refraction",
      "description": "How far the surface bends the background.",
      "type": "float",
      "value": 0.045,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 5,
