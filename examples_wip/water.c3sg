  "comments": [
    {
      "id": 1,
      "x": 0,
      "y": -1843,
      "width": 836,
      "height": 324,
      "title": "Wave space",
      "description": "UV normalised to 0..1 across the object, then scaled so Wave Scale is the number of wave cells across it.",
      "color": "#4a90e2"
    },
    {
      "id": 2,
      "x": 1190,
      "y": 1459,
      "width": 660,
      "height": 480,
      "title": "Wave field",
      "description": "Height of the water at this pixel. Sampled again just to the right and just below, so the three taps can be differenced into a slope.",
      "color": "#4a90e2"
    },
    {
      "id": 3,
      "x": 0,
      "y": -1419,
      "width": 1830,
      "height": 1319,
      "title": "Surface normal",
      "description": "The two finite differences become the X and Y of a surface normal; the epsilon becomes its Z, which keeps the tilt independent of the sampling step.",
      "color": "#4a90e2"
    },
    {
      "id": 4,
      "x": 0,
      "y": 1933,
      "width": 616,
      "height": 324,
      "title": "Shape mask",
      "description": "The object's own alpha, so the water stays inside its silhouette.",
      "color": "#4a90e2"
    },
    {
      "id": 5,
      "x": 0,
      "y": 1459,
      "width": 1090,
      "height": 374,
      "title": "Crest foam",
      "description": "White foam on the top of the waves, faded in over the highest part of the height range.",
      "color": "#4a90e2"
    },
    {
      "id": 6,
      "x": 936,
      "y": -1843,
      "width": 609,
      "height": 299,
      "title": "Clock",
      "description": "Seconds since start, scaled by the Speed parameter. Drives the whole wave field.",
      "color": "#4a90e2"
    },
    {
      "id": 7,
      "x": 0,
      "y": 0,
      "width": 2620,
      "height": 1359,
      "title": "Composite",
      "description": "Tint the refracted background, add the glint and the foam, then fade the whole thing in behind the object's alpha.",
      "color": "#4a90e2"
    }
  ],
  "nodeIdCounter": 70,
  "commentIdCounter": 8,
  "uniforms": [
    {
      "id": 1,
      "paramId": "svelii5r",
      "name": "speed",
      "variableName": "uniform_speed",
      "description": "How fast the wave field evolves.",
