      "description": "Deep water tint.",
      "type": "color",
      "value": {
        "r": 0.06,
        "g": 0.36,
        "b": 0.5
      },
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 6,
      "paramId": "xe01u3gf",
      "name": "tint",
      "variableName": "uniform_tint",
      "description": "How much of the water tint to mix in.",
