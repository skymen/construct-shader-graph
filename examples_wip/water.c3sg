      "value": 4,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 3,
      "paramId": "v07zfguw",
      "name": "waveHeight",
      "variableName": "uniform_waveHeight",
      "description": "Steepness of the wave normals.",
      "type": "float",
      "value": 1,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 4,
      "paramId": "gt6i3ogr",
      "name": "refraction",
      "variableName": "uniform_refraction",
      "description": "How far the surface bends the background.",
      "type": "float",
      "value": 0.045,
      "isPercent": false,
      "isDeprecated": false
    },
    {
      "id": 5,
      "paramId": "sgd7j5i7",
